<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e pastas reais são servidos direto (assets do Vite, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA (BrowserRouter): qualquer outra rota cai no index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache: assets com hash são imutáveis; index.html nunca cacheia
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(index\.html|service-worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
